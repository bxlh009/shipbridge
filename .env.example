# mock (default when PAYPAL_CLIENT_ID is empty) | sandbox | live
PAYPAL_MODE=mock

# API host when not in mock mode. sandbox (default) or live.
PAYPAL_ENV=sandbox

# Optional override, e.g. https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=

# Sandbox REST app credentials. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenAI-compatible chat completions. Leave blank to use deterministic fallbacks.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional. Defaults to LLM_MODEL. Used for manifest screenshots.
LLM_VISION_MODEL=
