# mock (default when PAYPAL_CLIENT_ID is empty) | sandbox | live
# Process environment wins over .env and .env.local. next start still loads .env.local,
# so mock checks must set PAYPAL_MODE=mock in the shell when .env.local says sandbox.
PAYPAL_MODE=mock

# API host when not in mock mode. sandbox (default) or live.
PAYPAL_ENV=sandbox

# Optional override, e.g. https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=

# Sandbox REST app credentials. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# OpenAI-compatible chat completions. Leave blank to use deterministic fallbacks.
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional. Defaults to LLM_MODEL. Used for manifest screenshots.
LLM_VISION_MODEL=
# Optional. Defaults: 8000ms text, 20000ms vision. Aborts so the function can fall back.
# LLM_TIMEOUT_MS=
# LLM_VISION_TIMEOUT_MS=
